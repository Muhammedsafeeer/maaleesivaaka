# Environment variable template — copy to .env.local and fill in real values.
# .env.local is gitignored; this file is committed so every developer knows
# what to set. See docs/architecture.md §20 and docs/decisions.md D-006.

# Supabase project URL. Public — safe to expose to the browser.
# Found in: Supabase dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key. Public — safe to expose to the browser.
# Row Level Security is what actually restricts what this key can read/write.
# Found in: Supabase dashboard → Project Settings → API → Project API keys → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. SECRET — bypasses Row Level Security entirely.
# Per D-006, this is read in exactly one place: the route handler that
# creates judge accounts via the Supabase Admin API. It must never be
# prefixed with NEXT_PUBLIC_ and must never reach the client bundle.
# Found in: Supabase dashboard → Project Settings → API → Project API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=
